# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：Bangumi 专用 HTTP(S) 代理，仅影响动漫目录和新番放送，不改变影视播放请求。
# 直连 api.bgm.tv 不通时，填写自己受信任的代理地址；默认不使用代理。
# BANGUMI_PROXY_URL=http://127.0.0.1:7890

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:2.0.1

# 可选：排行榜缓存时长（毫秒，默认 1 小时，允许 30000~21600000）。
# 前端开启「实时更新」（每 60 秒轮询一次），服务端按此时长缓存上游榜单。
# HOT_LIST_CACHE_TTL_MS=3600000

# 可选：预置点播源 / 直播源（JSON 数组，服务端下发，所有客户端自动出现并默认勾选）。
# 例：DEFAULT_SOURCES=[{"name":"量子资源","url":"https://cj.lziapi.com/api.php/provide/vod"}]
# 每项支持 name、url、key（可选，默认按序号生成 env_0...）、isAdult（可选）。
# DEFAULT_SOURCES=
# DEFAULT_LIVE_SOURCES=[{"name":"IPTV-org 中国频道","url":"https://iptv-org.github.io/iptv/countries/cn.m3u"}]

# 可选：弹幕服务地址（本地自建 danmu_api，见 docs/LOCAL-ENHANCEMENTS.md）。
# 不设置或服务不可用时弹幕功能自动关闭，不影响播放。
# DANMU_API_BASE=http://127.0.0.1:9321

# 可选：ffmpeg 可执行文件路径，供「智能识别片头」分析视频开头使用。
# 打包版会自动探测 D:\LibreTV\bin\ffmpeg.exe、/usr/local/bin、/usr/bin，再回退到 PATH 里的 ffmpeg；
# 未安装 ffmpeg 时智能识别自动降级为固定秒数跳过。
# FFMPEG_PATH=/usr/bin/ffmpeg
